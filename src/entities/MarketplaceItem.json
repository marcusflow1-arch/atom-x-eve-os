{
  "name": "MarketplaceItem",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string",
      "description": "User ID of the seller"
    },
    "seller_name": {
      "type": "string",
      "description": "Display name of the seller"
    },
    "item_name": {
      "type": "string",
      "description": "Name of the item"
    },
    "item_type": {
      "type": "string",
      "description": "Type of item"
    },
    "item_rarity": {
      "type": "string",
      "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Unique"]
    },
    "item_image": {
      "type": "string",
      "description": "Image URL"
    },
    "item_description": {
      "type": "string",
      "description": "Listing description"
    },
    "game_name": {
      "type": "string",
      "description": "Game this item belongs to"
    },
    "listing_mode": {
      "type": "string",
      "enum": ["sale", "trade", "sale_or_trade"],
      "default": "sale"
    },
    "currency_type": {
      "type": "string",
      "enum": ["AGP", "USD", "BOTH"],
      "default": "AGP"
    },
    "price_agp": {
      "type": "number"
    },
    "price_usd": {
      "type": "number"
    },
    "trade_preferences": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": ["active", "in_escrow", "sold", "traded", "cancelled"],
      "default": "active"
    }
  },
  "required": ["seller_id", "item_name", "item_type", "listing_mode", "currency_type"]
}