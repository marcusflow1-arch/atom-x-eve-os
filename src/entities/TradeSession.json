{
  "name": "TradeSession",
  "type": "object",
  "properties": {
    "initiator_id": {
      "type": "string",
      "description": "User who started the deal"
    },
    "recipient_id": {
      "type": "string",
      "description": "Other user in the deal"
    },
    "listing_id": {
      "type": "string",
      "description": "CardTrade listing involved, if any"
    },
    "session_type": {
      "type": "string",
      "enum": ["card_trade", "item_trade", "purchase"],
      "default": "card_trade"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "accepted", "escrow", "completed", "declined", "cancelled"],
      "default": "pending"
    },
    "initiator_offer_card_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "recipient_offer_card_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "initiator_offer_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "rarity": { "type": "string" },
          "image": { "type": "string" },
          "game": { "type": "string" }
        }
      },
      "default": []
    },
    "recipient_offer_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "rarity": { "type": "string" },
          "image": { "type": "string" },
          "game": { "type": "string" }
        }
      },
      "default": []
    },
    "payment_mode": {
      "type": "string",
      "enum": ["none", "AGP", "USD"],
      "default": "none"
    },
    "payment_amount": {
      "type": "number"
    },
    "escrow_state": {
      "type": "string",
      "enum": ["not_started", "holding", "released"],
      "default": "not_started"
    },
    "initiator_confirmed": {
      "type": "boolean",
      "default": false
    },
    "recipient_confirmed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["initiator_id", "recipient_id", "session_type"]
}