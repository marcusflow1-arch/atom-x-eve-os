{
  "name": "CardTrade",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string",
      "description": "User ID of the seller"
    },
    "buyer_id": {
      "type": "string",
      "description": "User ID of the buyer if sold"
    },
    "card_id": {
      "type": "string",
      "description": "UserCard record being listed"
    },
    "card_snapshot": {
      "type": "object",
      "description": "Snapshot of the card at listing time",
      "properties": {
        "name": { "type": "string" },
        "rarity": { "type": "string" },
        "image": { "type": "string" },
        "game": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "listing_type": {
      "type": "string",
      "enum": ["fixed_price", "trade_offer"],
      "default": "fixed_price"
    },
    "currency_type": {
      "type": "string",
      "enum": ["AGP", "USD", "BOTH"],
      "default": "AGP"
    },
    "asking_price_agp": {
      "type": "number",
      "description": "AGP price if applicable"
    },
    "asking_price_usd": {
      "type": "number",
      "description": "USD price if applicable"
    },
    "trade_preferences": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Cards or item names wanted in return"
    },
    "status": {
      "type": "string",
      "enum": ["active", "in_escrow", "sold", "cancelled", "expired"],
      "default": "active"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "views": {
      "type": "number",
      "default": 0
    }
  },
  "required": ["seller_id", "card_id", "listing_type", "currency_type"]
}