{
  "name": "Auto-Analyze Knowledge URL on Upload",
  "description": "When a new PendingKnowledgeURL is created (from UI or manually), automatically fetch the URL content server-side, run AI analysis, and create a KnowledgeEntry. Works even when the user is offline.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PendingKnowledgeURL"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_analyze_knowledge_url_on_upload",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoAnalyzeURL",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoAnalyzeURL"
  }
}