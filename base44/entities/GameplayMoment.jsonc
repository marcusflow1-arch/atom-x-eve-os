{
  "name": "GameplayMoment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "image_uri": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "screenshot",
        "highlight",
        "coaching",
        "observation"
      ]
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ai"
      ]
    },
    "ai_review": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        },
        "practice": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "user_id",
    "record_id",
    "timestamp",
    "kind"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}