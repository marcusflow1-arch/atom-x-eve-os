{
  "name": "AuraSponsor",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "name": {
      "type": "string",
      "description": "Sponsor name"
    },
    "logo_url": {
      "type": "string",
      "description": "Sponsor logo image URL"
    },
    "description": {
      "type": "string",
      "description": "Brief description"
    },
    "tier": {
      "type": "string",
      "enum": [
        "platinum",
        "gold",
        "silver",
        "bronze"
      ],
      "default": "bronze",
      "description": "Sponsorship tier"
    },
    "affiliate_link": {
      "type": "string",
      "description": "Affiliate/partner link"
    },
    "promo_code": {
      "type": "string",
      "description": "Promo code for viewers"
    },
    "api_key": {
      "type": "string",
      "description": "API key for sponsor integrations"
    },
    "promo_media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "url": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        }
      },
      "description": "Promotional media for sponsor"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "merch",
              "product",
              "event"
            ]
          },
          "price": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "description": "Sponsor products"
    }
  },
  "required": [
    "user_id",
    "name"
  ]
}