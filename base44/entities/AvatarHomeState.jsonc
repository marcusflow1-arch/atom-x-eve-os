{
  "name": "AvatarHomeState",
  "type": "object",
  "properties": {
    "avatarId": {
      "type": "string",
      "description": "ID of the avatar/user this home belongs to"
    },
    "currentEnvironmentId": {
      "type": "string",
      "description": "ID of the currently selected 3D environment model"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "mood": {
      "type": "string",
      "default": "calm"
    },
    "catchphrase": {
      "type": "string",
      "default": "Welcome in. Make yourself at home."
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "activityLog": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "preferences": {
      "type": "object",
      "default": {}
    }
  },
  "required": [
    "avatarId"
  ]
}