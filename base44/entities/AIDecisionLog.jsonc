{
  "name": "AIDecisionLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who made the decision"
    },
    "avatar_id": {
      "type": "string",
      "description": "Avatar affected by this decision"
    },
    "game_id": {
      "type": "string",
      "description": "Game where decision was made"
    },
    "decision_type": {
      "type": "string",
      "enum": [
        "moral_choice",
        "combat_action",
        "dialogue_choice",
        "resource_decision",
        "alliance_action",
        "exploration_choice"
      ],
      "description": "Category of decision"
    },
    "decision_context": {
      "type": "string",
      "description": "Brief description of the situation"
    },
    "choice_made": {
      "type": "string",
      "description": "What the player chose"
    },
    "moral_weight": {
      "type": "number",
      "description": "Impact on moral alignment (-10 to +10)"
    },
    "aggression_impact": {
      "type": "number",
      "description": "Impact on aggression tendency (-5 to +5)"
    },
    "empathy_impact": {
      "type": "number",
      "description": "Impact on empathy level (-5 to +5)"
    },
    "risk_impact": {
      "type": "number",
      "description": "Impact on risk tolerance (-5 to +5)"
    },
    "trait_impacts": {
      "type": "object",
      "properties": {
        "loyalty": {
          "type": "number"
        },
        "curiosity": {
          "type": "number"
        },
        "caution": {
          "type": "number"
        },
        "humor": {
          "type": "number"
        },
        "wisdom": {
          "type": "number"
        },
        "impulsiveness": {
          "type": "number"
        }
      },
      "description": "How this decision affects personality traits"
    },
    "was_consistent": {
      "type": "boolean",
      "default": true,
      "description": "Whether this decision aligned with AI's current personality"
    },
    "ai_reaction": {
      "type": "string",
      "description": "How the AI reacted to this decision"
    }
  },
  "required": [
    "user_id",
    "avatar_id",
    "decision_type",
    "choice_made"
  ]
}