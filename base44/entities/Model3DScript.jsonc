{
  "name": "Model3DScript",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name/identifier for this script"
    },
    "description": {
      "type": "string",
      "description": "What this script does"
    },
    "model_reference": {
      "type": "string",
      "description": "Reference to which model this applies to (e.g., 'Luna Dashboard Y Bot', 'General')"
    },
    "page_location": {
      "type": "string",
      "description": "Where this model is used (e.g., 'LunaTemplate', 'Dashboard', 'All')"
    },
    "script_code": {
      "type": "string",
      "description": "JavaScript/Three.js code for the 3D model"
    },
    "model_url": {
      "type": "string",
      "description": "URL to the 3D model file"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this script is currently active"
    },
    "script_type": {
      "type": "string",
      "enum": [
        "animation",
        "behavior",
        "shader",
        "interaction",
        "general"
      ],
      "default": "general",
      "description": "Type of script"
    }
  },
  "required": [
    "name",
    "model_reference",
    "script_code"
  ]
}