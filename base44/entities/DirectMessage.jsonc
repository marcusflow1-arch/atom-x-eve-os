{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User ID who sent the message"
    },
    "receiver_id": {
      "type": "string",
      "description": "User ID who receives the message"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    },
    "conversation_id": {
      "type": "string",
      "description": "ID linking messages in same conversation"
    }
  },
  "required": [
    "sender_id",
    "receiver_id",
    "content"
  ]
}