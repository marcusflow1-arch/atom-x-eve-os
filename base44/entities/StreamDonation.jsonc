{
  "name": "StreamDonation",
  "type": "object",
  "properties": {
    "from_user_id": {
      "type": "string",
      "description": "ID of user making donation"
    },
    "to_streamer_id": {
      "type": "string",
      "description": "ID of streamer receiving donation"
    },
    "stream_id": {
      "type": "string",
      "description": "ID of stream where donation occurred (optional)"
    },
    "amount": {
      "type": "number",
      "description": "Donation amount in AGP (Atom Gaming Points)"
    },
    "message": {
      "type": "string",
      "description": "Optional message with donation"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Whether donation is anonymous"
    }
  },
  "required": [
    "from_user_id",
    "to_streamer_id",
    "amount"
  ]
}