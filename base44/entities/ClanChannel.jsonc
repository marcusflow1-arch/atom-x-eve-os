{
  "name": "ClanChannel",
  "type": "object",
  "properties": {
    "divisionId": {
      "type": "string",
      "description": "ID of the division this channel belongs to"
    },
    "name": {
      "type": "string",
      "description": "Name of the channel (e.g. 'general', 'raid-planning')"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "voice"
      ],
      "default": "text"
    },
    "categoryId": {
      "type": "string",
      "description": "Optional category grouping"
    },
    "position": {
      "type": "number",
      "default": 0
    },
    "role_restriction": {
      "type": "string",
      "enum": [
        "none",
        "officer",
        "leader"
      ],
      "default": "none",
      "description": "Minimum role required to view and post in this channel. 'none' = everyone, 'officer' = officers and leaders, 'leader' = leaders only."
    }
  },
  "required": [
    "divisionId",
    "name",
    "type"
  ]
}