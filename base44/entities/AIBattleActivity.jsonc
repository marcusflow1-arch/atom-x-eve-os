{
  "name": "AIBattleActivity",
  "type": "object",
  "properties": {
    "mode": { "type": "string", "enum": ["pve", "pvwe"] },
    "activity_type": { "type": "string", "enum": ["mob", "boss", "world_boss", "treasure", "quest"] },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "description": { "type": "string" },
    "difficulty": { "type": "string", "enum": ["normal", "hard", "elite", "mythic"] },
    "enemy_name": { "type": "string" },
    "enemy_level": { "type": "number", "default": 1 },
    "max_hp": { "type": "number", "default": 100 },
    "current_hp": { "type": "number", "default": 100 },
    "recommended_power": { "type": "number", "default": 100 },
    "objective_text": { "type": "string" },
    "objective_target": { "type": "number", "default": 1 },
    "region": { "type": "string" },
    "biome": { "type": "string" },
    "reward_xp": { "type": "number", "default": 0 },
    "reward_card_xp": { "type": "number", "default": 0 },
    "reward_agp": { "type": "number", "default": 0 },
    "reward_description": { "type": "string" },
    "status": { "type": "string", "enum": ["upcoming", "active", "completed"], "default": "active" },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "participants_count": { "type": "number", "default": 0 },
    "revision": { "type": "number", "default": 1 }
  },
  "required": ["mode", "activity_type", "title", "difficulty", "status"]
}