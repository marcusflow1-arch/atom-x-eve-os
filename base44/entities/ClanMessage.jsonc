{
  "name": "ClanMessage",
  "type": "object",
  "properties": {
    "divisionId": {
      "type": "string"
    },
    "channelId": {
      "type": "string",
      "description": "ID of the channel this message belongs to"
    },
    "author": {
      "type": "string"
    },
    "authorAvatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "userId": {
      "type": "string",
      "description": "ID of the user who sent the message"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "officer",
        "leader"
      ],
      "description": "Snapshot of the sender's role at time of posting"
    },
    "isPinned": {
      "type": "boolean",
      "default": false
    },
    "isAnnouncement": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "divisionId",
    "author",
    "content"
  ]
}