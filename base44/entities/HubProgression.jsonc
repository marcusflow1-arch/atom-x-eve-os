{
  "name": "HubProgression",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user this progression belongs to. One record per user."
    },
    "global_hub_level": {
      "type": "number",
      "default": 1,
      "description": "Account-wide hub level. Unlocks core system access across all environments."
    },
    "global_hub_xp": {
      "type": "number",
      "default": 0,
      "description": "Total XP toward the next global hub level"
    },
    "total_environments_owned": {
      "type": "number",
      "default": 1,
      "description": "Count of environments owned"
    },
    "active_environment_id": {
      "type": "string",
      "description": "ID of the currently active EnvironmentInstance"
    },
    "unlocked_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of globally unlocked feature IDs (shop, blacksmith, arena, etc.)"
    },
    "mastery_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Account-wide mastery badges earned (soulbound, never transferable)"
    },
    "market_reputation": {
      "type": "number",
      "default": 0,
      "description": "Reputation score from trading environments"
    },
    "imprints_created": {
      "type": "number",
      "default": 0,
      "description": "Total imprints created by this user"
    },
    "imprints_sold": {
      "type": "number",
      "default": 0,
      "description": "Total imprints sold by this user"
    }
  },
  "required": [
    "user_id"
  ]
}