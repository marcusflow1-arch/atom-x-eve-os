{
  "name": "OnboardingProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "live",
        "preview"
      ]
    },
    "display_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "avatar_id": {
      "type": "string"
    },
    "companion": {
      "type": "object"
    },
    "completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "environment",
    "display_name",
    "username"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}