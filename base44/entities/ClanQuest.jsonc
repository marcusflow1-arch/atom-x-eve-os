{
  "name": "ClanQuest",
  "type": "object",
  "properties": {
    "divisionId": {
      "type": "string",
      "description": "ID of the clan"
    },
    "creatorId": {
      "type": "string",
      "description": "User ID of the quest giver"
    },
    "title": {
      "type": "string",
      "description": "Quest title"
    },
    "description": {
      "type": "string",
      "description": "Quest details and objectives"
    },
    "requirements": {
      "type": "string",
      "description": "Prerequisites or gear needed"
    },
    "rewards": {
      "type": "string",
      "description": "What participants get"
    },
    "maxParticipants": {
      "type": "number",
      "default": 5
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of user IDs participating"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "active",
        "completed"
      ],
      "default": "open"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "divisionId",
    "title",
    "status"
  ]
}