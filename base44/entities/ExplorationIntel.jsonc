{
  "name": "ExplorationIntel",
  "type": "object",
  "properties": {
    "clan_id": {
      "type": "string",
      "description": "Clan owning this intel"
    },
    "game_id": {
      "type": "string",
      "description": "Game context for the intel"
    },
    "title": {
      "type": "string",
      "description": "Short title for the recon upload"
    },
    "notes": {
      "type": "string",
      "description": "Details, findings, how to unlock, etc."
    },
    "location": {
      "type": "string",
      "description": "Where this was found (zone, coords)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scouted",
        "found",
        "cleared"
      ],
      "default": "scouted",
      "description": "Recon status"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Uploaded images/videos URLs"
    }
  },
  "required": [
    "clan_id",
    "game_id",
    "title"
  ]
}