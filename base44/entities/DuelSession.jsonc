{
  "name": "DuelSession",
  "type": "object",
  "properties": {
    "challenger_id": {
      "type": "string",
      "description": "User ID of the player who issued the duel"
    },
    "challenger_name": {
      "type": "string"
    },
    "opponent_id": {
      "type": "string",
      "description": "User ID of the player who accepted the duel"
    },
    "opponent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "finished"
      ],
      "default": "active"
    },
    "winner_id": {
      "type": "string",
      "description": "User ID of the winner (set when status=finished)"
    },
    "loser_id": {
      "type": "string"
    },
    "challenger_hp": {
      "type": "number",
      "default": 100
    },
    "opponent_hp": {
      "type": "number",
      "default": 100
    },
    "max_hp": {
      "type": "number",
      "default": 100
    },
    "challenger_loadout": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Snapshot of challenger Skill Book cards when duel begins"
    },
    "opponent_loadout": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Snapshot of opponent Skill Book cards when duel begins"
    },
    "challenger_power": {
      "type": "number",
      "default": 0
    },
    "opponent_power": {
      "type": "number",
      "default": 0
    },
    "battle_format": {
      "type": "string",
      "default": "card_duel"
    }
  },
  "required": [
    "challenger_id",
    "opponent_id"
  ]
}