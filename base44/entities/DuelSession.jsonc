{
  "name": "DuelSession",
  "type": "object",
  "properties": {
    "challenger_id": {
      "type": "string",
      "description": "User ID of the player who issued the duel"
    },
    "challenger_name": {
      "type": "string"
    },
    "opponent_id": {
      "type": "string",
      "description": "User ID of the player who was challenged"
    },
    "opponent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "finished",
        "declined",
        "expired"
      ],
      "default": "pending",
      "description": "pending = challenge sent; active = accepted and fighting; finished = someone won, forfeited or the duel timed out"
    },
    "winner_id": {
      "type": "string",
      "description": "User ID of the winner (set when status=finished)"
    },
    "loser_id": {
      "type": "string"
    },
    "finish_reason": {
      "type": "string",
      "description": "knockout | forfeit | timeout"
    },
    "challenger_hp": {
      "type": "number",
      "default": 100
    },
    "opponent_hp": {
      "type": "number",
      "default": 100
    },
    "max_hp": {
      "type": "number",
      "default": 100,
      "description": "Legacy single pool size; duels now use each duelist's own max HP"
    },
    "challenger_max_hp": {
      "type": "number"
    },
    "opponent_max_hp": {
      "type": "number"
    },
    "challenger_stats": {
      "type": "object",
      "description": "The challenger's combat stats for this duel, clamped by the server (axePowerBudget clampAXEDuelStats)"
    },
    "opponent_stats": {
      "type": "object",
      "description": "The opponent's combat stats for this duel, clamped by the server"
    },
    "last_hit_at": {
      "type": "object",
      "description": "user id -> epoch ms of that duelist's last accepted hit (the server's rate limit)"
    },
    "expires_at": {
      "type": "string",
      "description": "A pending challenge expires at this time"
    },
    "last_action_at": {
      "type": "string",
      "description": "An active duel with no hit for two minutes times out"
    }
  },
  "required": [
    "challenger_id",
    "opponent_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "id": "{{user.id}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
