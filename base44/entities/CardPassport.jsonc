{
  "name": "CardPassport",
  "type": "object",
  "properties": {
    "passport_id": { "type": "string", "description": "Permanent public identity for one owned card instance" },
    "user_card_id": { "type": "string" },
    "trading_card_id": { "type": "string" },
    "card_name": { "type": "string" },
    "current_owner_id": { "type": "string" },
    "original_owner_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "consumed", "retired"], "default": "active" },
    "authenticity_status": { "type": "string", "enum": ["registered_internal", "anchored_external"], "default": "registered_internal" },
    "ledger_adapter": { "type": "string", "default": "internal_hash_chain_v1" },
    "external_ledger_status": { "type": "string", "enum": ["not_anchored", "pending", "anchored"], "default": "not_anchored" },
    "external_ledger_tx": { "type": "string" },
    "event_count": { "type": "number", "default": 0 },
    "head_hash": { "type": "string" }
  },
  "required": ["passport_id", "user_card_id", "current_owner_id"],
  "rls": {
    "read": {
      "$or": [
        { "data.current_owner_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
