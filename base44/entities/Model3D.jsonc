{
  "name": "Model3D",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the 3D model"
    },
    "description": {
      "type": "string",
      "description": "Description of the model"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the uploaded entry 3D model file (GLB, GLTF, or FBX)"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "glb",
        "gltf",
        "fbx",
        "zip"
      ],
      "description": "Type of the 3D model file"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Preview thumbnail image URL"
    },
    "category": {
      "type": "string",
      "description": "Category for organizing models"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags for searching and filtering models"
    },
    "file_size": {
      "type": "number",
      "description": "Entry file size in bytes"
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "is_bundle": {
      "type": "boolean",
      "default": false
    },
    "entry_file": {
      "type": "string"
    },
    "bundle_manifest": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original_path": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "file_size": {
            "type": "number"
          },
          "mime_type": {
            "type": "string"
          }
        },
        "required": [
          "original_path",
          "file_url"
        ]
      }
    },
    "license_url": {
      "type": "string"
    },
    "player_spawn": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": -0.5
        },
        "z": {
          "type": "number",
          "default": 0
        }
      },
      "default": {
        "x": 0,
        "y": -0.5,
        "z": 0
      }
    },
    "use_mesh_collision": {
      "type": "boolean",
      "default": false
    },
    "role": {
      "type": "string",
      "enum": [
        "player",
        "enemy",
        "neutral",
        "companion"
      ],
      "default": "player",
      "description": "Role determines EXP gain/loss, targeting, and combat behavior"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "current_exp": {
      "type": "number",
      "default": 0
    },
    "exp_to_next_level": {
      "type": "number",
      "default": 100
    },
    "stats": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 100
        },
        "max_hp": {
          "type": "number",
          "default": 100
        },
        "attack": {
          "type": "number",
          "default": 10
        },
        "defense": {
          "type": "number",
          "default": 5
        },
        "speed": {
          "type": "number",
          "default": 1.0
        },
        "stamina": {
          "type": "number",
          "default": 100
        }
      },
      "default": {
        "hp": 100,
        "max_hp": 100,
        "attack": 10,
        "defense": 5,
        "speed": 1.0,
        "stamina": 100
      }
    },
    "stats_per_level": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 10
        },
        "attack": {
          "type": "number",
          "default": 2
        },
        "defense": {
          "type": "number",
          "default": 1
        },
        "speed": {
          "type": "number",
          "default": 0.05
        },
        "stamina": {
          "type": "number",
          "default": 5
        }
      },
      "default": {
        "hp": 10,
        "attack": 2,
        "defense": 1,
        "speed": 0.05,
        "stamina": 5
      }
    },
    "ai_enabled": {
      "type": "boolean",
      "default": false,
      "description": "If true, AI behavior controller is attached at runtime"
    },
    "spawn_key": {
      "type": "string",
      "default": "",
      "description": "Keyboard key code (e.g. KeyG, Digit3) that spawns this AI model in the 3D viewer when pressed"
    },
    "ai_profile": {
      "type": "object",
      "properties": {
        "behavior_type": {
          "type": "string",
          "enum": [
            "passive_wander",
            "aggressive",
            "defensive",
            "follower",
            "patrol_route",
            "idle_loop",
            "custom_script"
          ],
          "default": "idle_loop"
        },
        "detection_range": {
          "type": "number",
          "default": 10
        },
        "attack_range": {
          "type": "number",
          "default": 2
        },
        "aggression_level": {
          "type": "number",
          "default": 5
        },
        "wander_radius": {
          "type": "number",
          "default": 5
        },
        "patrol_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "default": []
        },
        "animations": {
          "type": "object",
          "properties": {
            "idle": {
              "type": "string"
            },
            "walk": {
              "type": "string"
            },
            "run": {
              "type": "string"
            },
            "attack": {
              "type": "string"
            },
            "hit": {
              "type": "string"
            },
            "death": {
              "type": "string"
            },
            "block": {
              "type": "string"
            },
            "dodge": {
              "type": "string"
            },
            "special": {
              "type": "string"
            }
          },
          "default": {}
        }
      },
      "default": {
        "behavior_type": "idle_loop",
        "detection_range": 10,
        "attack_range": 2,
        "aggression_level": 5,
        "wander_radius": 5,
        "patrol_points": [],
        "animations": {}
      }
    }
  },
  "required": [
    "name",
    "file_url",
    "file_type"
  ]
}