{
  "name": "EnvironmentInstance",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID who owns this environment instance"
    },
    "name": {
      "type": "string",
      "description": "Display name of the environment"
    },
    "description": {
      "type": "string",
      "description": "Description of the environment"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Rare",
        "Epic",
        "Legendary",
        "Mythical"
      ],
      "default": "Common",
      "description": "Rarity tier of the environment"
    },
    "environment_rank": {
      "type": "number",
      "default": 1,
      "description": "Per-environment rank level (1-20)"
    },
    "environment_xp": {
      "type": "number",
      "default": 0,
      "description": "XP accumulated toward next environment rank"
    },
    "is_soulbound": {
      "type": "boolean",
      "default": true,
      "description": "Whether this environment is bound to the owner"
    },
    "is_imprintable": {
      "type": "boolean",
      "default": false,
      "description": "Whether this environment can be imprinted (Mythical at max rank only)"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the currently active environment for the user"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Preview thumbnail image URL"
    },
    "model_url": {
      "type": "string",
      "description": "URL to the 3D model file for this environment"
    },
    "scene_layout_id": {
      "type": "string",
      "description": "Reference to the SceneLayout entity for rendering data"
    },
    "structures": {
      "type": "object",
      "description": "Feature structure levels within the environment",
      "properties": {
        "shop": {
          "type": "number",
          "default": 0
        },
        "blacksmith": {
          "type": "number",
          "default": 0
        },
        "arena": {
          "type": "number",
          "default": 0
        },
        "trophy_room": {
          "type": "number",
          "default": 0
        },
        "guild_hall": {
          "type": "number",
          "default": 0
        },
        "enchanting": {
          "type": "number",
          "default": 0
        },
        "vault": {
          "type": "number",
          "default": 0
        },
        "portal": {
          "type": "number",
          "default": 0
        }
      }
    },
    "visual_state": {
      "type": "object",
      "description": "Visual customization state (time of day, weather, theme, etc.)"
    },
    "mastery_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Permanently soulbound mastery achievements earned in this environment"
    },
    "unlocked_via": {
      "type": "string",
      "description": "How this environment was acquired: achievement, purchase, imprint, default"
    },
    "game_origin": {
      "type": "string",
      "description": "Game that unlocked this environment (if achievement-based)"
    }
  },
  "required": [
    "owner_id",
    "name",
    "rarity"
  ]
}