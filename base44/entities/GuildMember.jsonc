{
  "name": "GuildMember",
  "type": "object",
  "properties": {
    "guild_id": {
      "type": "string",
      "description": "ID of the guild"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user"
    },
    "role": {
      "type": "string",
      "enum": [
        "leader",
        "officer",
        "member",
        "recruit"
      ],
      "default": "recruit"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "contribution_points": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "guild_id",
    "user_id"
  ]
}