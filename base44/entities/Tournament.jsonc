{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the tournament"
    },
    "game_id": {
      "type": "string",
      "description": "ID of the game being played"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "prize_pool": {
      "type": "string",
      "description": "Description of the prize pool"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "live",
        "completed"
      ],
      "default": "upcoming"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of participant user IDs"
    },
    "stream_link": {
      "type": "string",
      "description": "Link to the live stream"
    }
  },
  "required": [
    "title",
    "game_id",
    "start_date",
    "status"
  ]
}