{
  "name": "AIBattleRewardClaim",
  "type": "object",
  "properties": {
    "encounter_id": { "type": "string" },
    "user_id": { "type": "string" },
    "request_id": { "type": "string" },
    "route_id": { "type": "string" },
    "avatar_xp": { "type": "number", "default": 0 },
    "card_xp_each": { "type": "number", "default": 0 },
    "agp": { "type": "number", "default": 0 },
    "status": { "type": "string", "enum": ["applying", "applied"], "default": "applying" },
    "applied_at": { "type": "string", "format": "date-time" }
  },
  "required": ["encounter_id", "user_id", "request_id", "route_id", "status"],
  "rls": {
    "read": { "data.user_id": "{{user.id}}" },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}