{
  "name": "PendingKnowledgeURL",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "description": "The URL to fetch and analyze (Google Doc, Google Sheet, GitHub, raw text, etc.)"
    },
    "label": {
      "type": "string",
      "description": "Optional label/filename for this knowledge entry"
    },
    "folder_label": {
      "type": "string",
      "description": "Optional batch/folder label for grouping (e.g. 'Unreal Character System')"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Processing status"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if processing failed"
    },
    "knowledge_entry_id": {
      "type": "string",
      "description": "ID of the KnowledgeEntry created after successful analysis"
    }
  },
  "required": [
    "url"
  ]
}