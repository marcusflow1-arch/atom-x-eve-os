{
  "name": "Bid",
  "type": "object",
  "properties": {
    "bidder_id": {
      "type": "string",
      "description": "ID of the user placing the bid"
    },
    "auction_id": {
      "type": "string",
      "description": "ID of the auction/item"
    },
    "amount": {
      "type": "number",
      "description": "Bid amount"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "won",
        "lost",
        "outbid"
      ],
      "default": "active"
    },
    "item_name": {
      "type": "string",
      "description": "Name of the item (for easier display)"
    }
  },
  "required": [
    "bidder_id",
    "auction_id",
    "amount"
  ]
}