{
  "name": "ReactorFX",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of this FX effect (e.g. Lightning Burst, Fire Slash)"
    },
    "effect_type": {
      "type": "string",
      "enum": [
        "projectile",
        "burst",
        "aura",
        "beam",
        "trail",
        "impact"
      ],
      "default": "burst"
    },
    "file_url": {
      "type": "string",
      "description": "URL of the uploaded FBX/GLB effect file"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "fbx",
        "glb",
        "particle_json"
      ],
      "default": "fbx"
    },
    "texture_url": {
      "type": "string",
      "description": "Optional texture file for the effect"
    },
    "particle_config": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON particle system config (color, speed, count, lifetime, etc.)"
    },
    "duration": {
      "type": "number",
      "default": 1.0,
      "description": "Duration of the effect in seconds"
    },
    "is_looping": {
      "type": "boolean",
      "default": false
    },
    "scale": {
      "type": "number",
      "default": 1.0
    },
    "color": {
      "type": "string",
      "default": "#ffffff",
      "description": "Primary color tint for the effect"
    },
    "bone_attachment": {
      "type": "string",
      "default": "",
      "description": "Default bone to attach to"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "effect_type"
  ]
}