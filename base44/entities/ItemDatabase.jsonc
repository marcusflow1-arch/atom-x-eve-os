{
  "name": "ItemDatabase",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "Unique identifier for the item"
    },
    "name": {
      "type": "string",
      "description": "Display name of the item"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "weapon",
        "armor",
        "ability",
        "consumable"
      ],
      "description": "Type of item"
    },
    "slot_type": {
      "type": "string",
      "enum": [
        "weapon",
        "offhand",
        "head",
        "chest",
        "legs",
        "boots",
        "gloves",
        "skill"
      ],
      "description": "Equipment slot for this item"
    },
    "icon_url": {
      "type": "string",
      "description": "URL to the item's icon image"
    },
    "model_url": {
      "type": "string",
      "description": "URL to the 3D model from Asset Manager"
    },
    "idle_animation": {
      "type": "string",
      "description": "Animation name for idle state"
    },
    "attack_animation": {
      "type": "string",
      "description": "Animation name for attack action"
    },
    "ability_animation": {
      "type": "string",
      "description": "Animation name for special ability"
    },
    "description": {
      "type": "string",
      "description": "Item description"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Mythical"
      ],
      "description": "Item rarity tier"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this item is active"
    }
  },
  "required": [
    "item_id",
    "name",
    "item_type",
    "slot_type"
  ]
}