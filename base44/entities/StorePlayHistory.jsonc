{
  "name": "StorePlayHistory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "last_played": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "game_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
