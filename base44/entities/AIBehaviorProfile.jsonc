{
  "name": "AIBehaviorProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of this behavior profile (e.g. 'Aggressive Guard', 'Passive Wanderer')"
    },
    "description": {
      "type": "string",
      "description": "Description of what this behavior does"
    },
    "source_model_id": {
      "type": "string",
      "description": "The Model3D ID this profile was originally created from"
    },
    "source_model_name": {
      "type": "string",
      "description": "Name of the source model for display"
    },
    "role": {
      "type": "string",
      "enum": [
        "player",
        "enemy",
        "neutral",
        "companion"
      ],
      "default": "enemy"
    },
    "ai_enabled": {
      "type": "boolean",
      "default": true
    },
    "spawn_key": {
      "type": "string",
      "default": ""
    },
    "stats": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 100
        },
        "max_hp": {
          "type": "number",
          "default": 100
        },
        "attack": {
          "type": "number",
          "default": 10
        },
        "defense": {
          "type": "number",
          "default": 5
        },
        "speed": {
          "type": "number",
          "default": 1.0
        },
        "stamina": {
          "type": "number",
          "default": 100
        }
      },
      "default": {
        "hp": 100,
        "max_hp": 100,
        "attack": 10,
        "defense": 5,
        "speed": 1.0,
        "stamina": 100
      }
    },
    "stats_per_level": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 10
        },
        "attack": {
          "type": "number",
          "default": 2
        },
        "defense": {
          "type": "number",
          "default": 1
        },
        "speed": {
          "type": "number",
          "default": 0.05
        },
        "stamina": {
          "type": "number",
          "default": 5
        }
      },
      "default": {
        "hp": 10,
        "attack": 2,
        "defense": 1,
        "speed": 0.05,
        "stamina": 5
      }
    },
    "ai_profile": {
      "type": "object",
      "properties": {
        "behavior_type": {
          "type": "string",
          "enum": [
            "passive_wander",
            "aggressive",
            "defensive",
            "follower",
            "patrol_route",
            "idle_loop"
          ],
          "default": "idle_loop"
        },
        "detection_range": {
          "type": "number",
          "default": 10
        },
        "attack_range": {
          "type": "number",
          "default": 2
        },
        "aggression_level": {
          "type": "number",
          "default": 5
        },
        "wander_radius": {
          "type": "number",
          "default": 5
        },
        "patrol_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "default": []
        },
        "animations": {
          "type": "object",
          "default": {}
        }
      },
      "default": {
        "behavior_type": "idle_loop",
        "detection_range": 10,
        "attack_range": 2,
        "aggression_level": 5,
        "wander_radius": 5,
        "patrol_points": [],
        "animations": {}
      }
    }
  },
  "required": [
    "name",
    "source_model_id"
  ]
}