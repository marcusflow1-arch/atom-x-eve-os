{
  "name": "UserAchievement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The ID of the user."
    },
    "achievement_id": {
      "type": "string",
      "description": "The ID of the achievement."
    },
    "status": {
      "type": "string",
      "enum": [
        "locked",
        "in_progress",
        "unlocked"
      ],
      "default": "locked"
    },
    "progress": {
      "type": "object",
      "description": "JSON object for progress tracking (e.g., {\"current\": 5, \"total\": 10})."
    },
    "proof_media_url": {
      "type": "string",
      "description": "URL to a screenshot or video as proof of unlock."
    }
  },
  "required": [
    "user_id",
    "achievement_id",
    "status"
  ]
}