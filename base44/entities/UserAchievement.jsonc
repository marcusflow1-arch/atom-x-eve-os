{
  "name": "UserAchievement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "achievement_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "locked",
        "in_progress",
        "pending_review",
        "unlocked"
      ],
      "default": "locked"
    },
    "progress": {
      "type": "object"
    },
    "proof_media_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "game_event",
        "quest",
        "proof",
        "platform",
        "admin",
        "migration"
      ]
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "achievement_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.status": "pending_review"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}