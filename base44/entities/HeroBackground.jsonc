{
  "name": "HeroBackground",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name for the background"
    },
    "video_url": {
      "type": "string",
      "description": "URL of the uploaded MP4 video"
    },
    "audio_url": {
      "type": "string",
      "description": "URL of the uploaded MP3 audio file"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this background should be included in rotation"
    }
  },
  "required": []
}