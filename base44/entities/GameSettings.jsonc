{
  "name": "GameSettings",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "default",
      "description": "Settings profile name"
    },
    "exp_per_enemy_kill": {
      "type": "number",
      "default": 50,
      "description": "EXP awarded for killing a standard enemy"
    },
    "exp_per_boss_kill": {
      "type": "number",
      "default": 500,
      "description": "EXP awarded for killing a boss"
    },
    "exp_per_quest": {
      "type": "number",
      "default": 300,
      "description": "EXP awarded for completing a quest"
    },
    "exp_per_assist": {
      "type": "number",
      "default": 25,
      "description": "EXP awarded for an assist"
    },
    "exp_multiplier": {
      "type": "number",
      "default": 1.0,
      "description": "Global EXP multiplier"
    },
    "level_curve_type": {
      "type": "string",
      "enum": [
        "linear",
        "exponential",
        "custom"
      ],
      "default": "exponential",
      "description": "How EXP requirements scale per level"
    },
    "level_curve_base": {
      "type": "number",
      "default": 100,
      "description": "Base EXP for level 1 (used by linear/exponential)"
    },
    "level_curve_exponent": {
      "type": "number",
      "default": 1.5,
      "description": "Exponent for exponential scaling"
    },
    "custom_level_table": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "number"
          },
          "exp_required": {
            "type": "number"
          }
        }
      },
      "default": [
        {
          "level": 1,
          "exp_required": 100
        },
        {
          "level": 2,
          "exp_required": 250
        },
        {
          "level": 3,
          "exp_required": 500
        },
        {
          "level": 4,
          "exp_required": 900
        },
        {
          "level": 5,
          "exp_required": 1500
        }
      ],
      "description": "Custom level-to-EXP table (used when level_curve_type is custom)"
    },
    "max_level": {
      "type": "number",
      "default": 50,
      "description": "Maximum achievable level"
    }
  },
  "required": [
    "name"
  ]
}