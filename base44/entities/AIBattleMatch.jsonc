{
  "name": "AIBattleMatch",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "pvp",
        "pve",
        "world_boss"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "matched",
        "connecting",
        "countdown",
        "fighting",
        "ended"
      ],
      "default": "matched"
    },
    "host_id": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "dashboard_channel": {
      "type": "string"
    },
    "pair_key": {
      "type": "string"
    },
    "player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "arena": {
      "type": "object"
    },
    "positions": {
      "type": "object"
    },
    "atb": {
      "type": "object"
    },
    "cooldowns": {
      "type": "object"
    },
    "dodges": {
      "type": "object"
    },
    "stuns": {
      "type": "object",
      "description": "Per-player stun windows ({ from, until, cast_id, attacker_id }) applied by abilities such as Chidori. A stunned player cannot act until `until`."
    },
    "pending_hits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hit_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fight_starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "fight_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "winner_id": {
      "type": "string"
    },
    "ended_reason": {
      "type": "string",
      "enum": [
        "ko",
        "timeout",
        "forfeit",
        "disconnect"
      ]
    },
    "connected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when both reserved PvP clients have acknowledged the same match and the arena is allowed to open."
    },
    "ready_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "attack_revision": {
      "type": "integer",
      "default": 0
    },
    "last_attack": {
      "type": "object"
    },
    "last_cast": {
      "type": "object",
      "description": "Most recent accepted ability cast (cast_id, attacker_id, target_id, slot, effect_id, resolves_at). Lets both clients start the caster's animation without relying on the peer relay."
    },
    "disconnects": {
      "type": "object",
      "default": {},
      "description": "Per-player reconnect grace state keyed by player id."
    },
    "pause_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current reconnect pause began."
    },
    "prestige_awards": {
      "type": "object",
      "default": {},
      "description": "Per-player prestige earned for this completed PvP match."
    },
    "rewards_finalized": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "mode",
    "status",
    "host_id",
    "dashboard_channel",
    "pair_key",
    "player_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.player_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
