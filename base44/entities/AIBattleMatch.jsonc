{
  "name": "AIBattleMatch",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["pvp", "pve", "world_boss"]
    },
    "status": {
      "type": "string",
      "enum": ["matched", "ready", "ended"],
      "default": "matched"
    },
    "host_id": { "type": "string" },
    "host_name": { "type": "string" },
    "dashboard_channel": { "type": "string" },
    "pair_key": { "type": "string" },
    "player_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "players": {
      "type": "array",
      "items": { "type": "object" }
    },
    "current_turn_id": {
      "type": "string",
      "description": "Player ID that currently owns the PvP card-selection turn."
    },
    "turn_revision": {
      "type": "integer",
      "default": 0,
      "description": "Monotonic turn counter used to keep both PvP clients synchronized."
    },
    "turn_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "attack_revision": {
      "type": "integer",
      "default": 0,
      "description": "Monotonic server-side PvP hit counter."
    },
    "last_attack": {
      "type": "object",
      "description": "Last server-authoritative PvP hit. Carries source, target, damage and resulting HP so both clients reconcile the same combat result."
    },
    "ready_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" }
  },
  "required": ["mode", "status", "host_id", "dashboard_channel", "pair_key", "player_ids"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}