{
  "name": "AIBattleMatch",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "pvp",
        "pve",
        "world_boss"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "matched",
        "countdown",
        "fighting",
        "ended"
      ],
      "default": "matched"
    },
    "host_id": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "dashboard_channel": {
      "type": "string"
    },
    "pair_key": {
      "type": "string"
    },
    "player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "arena": {
      "type": "object"
    },
    "positions": {
      "type": "object"
    },
    "atb": {
      "type": "object"
    },
    "cooldowns": {
      "type": "object"
    },
    "dodges": {
      "type": "object"
    },
    "pending_hits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hit_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fight_starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "fight_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "winner_id": {
      "type": "string"
    },
    "ended_reason": {
      "type": "string",
      "enum": [
        "ko",
        "timeout",
        "forfeit",
        "disconnect"
      ]
    },
    "ready_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "attack_revision": {
      "type": "integer",
      "default": 0
    },
    "last_attack": {
      "type": "object"
    }
  },
  "required": [
    "mode",
    "status",
    "host_id",
    "dashboard_channel",
    "pair_key",
    "player_ids"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}