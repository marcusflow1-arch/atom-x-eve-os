{
  "name": "ViewerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Link to User entity"
    },
    "watch_time_minutes": {
      "type": "number",
      "default": 0
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "tier1",
        "tier2",
        "tier3"
      ],
      "default": "none"
    },
    "earned_perks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seasonal_progress": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "streamer_id": {
            "type": "string"
          },
          "xp": {
            "type": "number"
          },
          "level": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "user_id"
  ]
}