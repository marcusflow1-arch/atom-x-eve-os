{
  "name": "InfraChat",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ],
      "description": "Who sent the message"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "session_id": {
      "type": "string",
      "description": "Groups messages into a conversation session"
    },
    "model_used": {
      "type": "string",
      "description": "Which AI model was used for this response"
    },
    "knowledge_context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of KnowledgeEntry records used as context"
    },
    "actions_taken": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "pending"
            ]
          }
        }
      },
      "default": [],
      "description": "Actions the AI took as a result of this message"
    }
  },
  "required": [
    "role",
    "content",
    "session_id"
  ]
}