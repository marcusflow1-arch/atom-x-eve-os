{
  "name": "AvatarProgression",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "global_level": {
      "type": "number",
      "default": 1
    },
    "global_xp": {
      "type": "number",
      "default": 0
    },
    "available_stat_points": {
      "type": "number",
      "default": 0
    },
    "stats": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 100
        },
        "strength": {
          "type": "number",
          "default": 10
        },
        "intelligence": {
          "type": "number",
          "default": 10
        },
        "will": {
          "type": "number",
          "default": 10
        },
        "tenacity": {
          "type": "number",
          "default": 10
        }
      },
      "default": {
        "hp": 100,
        "strength": 10,
        "intelligence": 10,
        "will": 10,
        "tenacity": 10
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "number",
            "default": 1
          },
          "xp": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [
        {
          "name": "RPG",
          "level": 1,
          "xp": 0
        },
        {
          "name": "FPS",
          "level": 1,
          "xp": 0
        },
        {
          "name": "Strategy",
          "level": 1,
          "xp": 0
        },
        {
          "name": "Action",
          "level": 1,
          "xp": 0
        },
        {
          "name": "MMO",
          "level": 1,
          "xp": 0
        },
        {
          "name": "Puzzle",
          "level": 1,
          "xp": 0
        },
        {
          "name": "Simulation",
          "level": 1,
          "xp": 0
        },
        {
          "name": "Sports",
          "level": 1,
          "xp": 0
        }
      ]
    },
    "knowledge_level": {
      "type": "number",
      "default": 1,
      "description": "AI avatar knowledge progression level from 1 to 300"
    },
    "knowledge_xp": {
      "type": "number",
      "default": 0,
      "description": "XP toward the next AI knowledge level"
    },
    "available_skill_points": {
      "type": "number",
      "default": 0,
      "description": "Unspent AI skill-tree points"
    },
    "skill_allocations": {
      "type": "object",
      "description": "Persisted ranks for AI skill-tree categories and nodes"
    },
    "claimed_stat_rewards": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "Avatar level reward milestones already claimed"
    },
    "claimed_knowledge_rewards": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "Knowledge level reward milestones already claimed"
    }
  },
  "required": [
    "user_id"
  ]
}