{
  "name": "AvatarProgression",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "global_level": {
      "type": "number",
      "default": 1
    },
    "global_xp": {
      "type": "number",
      "default": 0
    },
    "available_stat_points": {
      "type": "number",
      "default": 0
    },
    "stats": {
      "type": "object",
      "properties": {
        "hp": {
          "type": "number",
          "default": 100
        },
        "strength": {
          "type": "number",
          "default": 10
        },
        "intelligence": {
          "type": "number",
          "default": 10
        },
        "will": {
          "type": "number",
          "default": 10
        },
        "tenacity": {
          "type": "number",
          "default": 10
        }
      },
      "default": {
        "hp": 100,
        "strength": 10,
        "intelligence": 10,
        "will": 10,
        "tenacity": 10
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "level": {
            "type": "number",
            "default": 1
          },
          "xp": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    },
    "knowledge_level": {
      "type": "number",
      "default": 1
    },
    "knowledge_xp": {
      "type": "number",
      "default": 0
    },
    "available_skill_points": {
      "type": "number",
      "default": 0
    },
    "skill_allocations": {
      "type": "object"
    },
    "claimed_stat_rewards": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "claimed_knowledge_rewards": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "reward_grant_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "prestige_score": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}