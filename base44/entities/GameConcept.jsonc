{
  "name": "GameConcept",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "voting",
        "in_development",
        "alpha",
        "beta",
        "released"
      ],
      "default": "proposed"
    },
    "votes": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user IDs who joined the project"
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "milestone": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "description",
    "author_id"
  ]
}