{
  "name": "ClanFormTopic",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "description": "Parent channel ID"
    },
    "game_id": {
      "type": "string",
      "description": "Game ID this topic belongs to"
    },
    "title": {
      "type": "string",
      "description": "Topic title"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "User who created the topic"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open",
      "description": "Topic open/closed"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "description": "Last activity timestamp"
    },
    "visibility_scope": {
      "type": "string",
      "enum": [
        "clan",
        "leaders",
        "both"
      ],
      "default": "clan",
      "description": "Where this topic appears: clan chat, leader chat, or both"
    }
  },
  "required": [
    "channel_id",
    "title"
  ]
}