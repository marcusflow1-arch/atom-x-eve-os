{
  "name": "VoiceRoom",
  "type": "object",
  "properties": {
    "clanId": {
      "type": "string",
      "description": "ID of the clan this room belongs to"
    },
    "gameId": {
      "type": "string",
      "description": "ID of the game workspace (optional)"
    },
    "topic": {
      "type": "string",
      "description": "The topic or purpose of the room"
    },
    "creatorId": {
      "type": "string",
      "description": "ID of the user who created the room"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of user IDs currently in the room"
    },
    "maxParticipants": {
      "type": "number",
      "default": 10,
      "description": "Maximum number of allowed participants"
    },
    "isTemporary": {
      "type": "boolean",
      "default": true,
      "description": "If true, the room is deleted when the last participant leaves"
    },
    "isLocked": {
      "type": "boolean",
      "default": false,
      "description": "If true, only leaders/officers or whitelisted users can join"
    },
    "minRole": {
      "type": "string",
      "enum": [
        "member",
        "officer",
        "leader"
      ],
      "default": "member",
      "description": "Minimum clan role required to join"
    },
    "allowedAssignmentId": {
      "type": "string",
      "description": "If set, restricts access to users with this assignment"
    },
    "settings": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "number"
        },
        "region": {
          "type": "string"
        }
      },
      "default": {}
    }
  },
  "required": [
    "clanId",
    "topic"
  ]
}