{
  "name": "AIBattleSession",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["pve", "pvwe"] },
    "activity_id": { "type": "string" },
    "activity_title": { "type": "string" },
    "activity_type": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "completed", "failed", "abandoned"], "default": "active" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "player_power": { "type": "number", "default": 0 },
    "player_hp_max": { "type": "number", "default": 100 },
    "player_hp_current": { "type": "number", "default": 100 },
    "enemy_hp_max": { "type": "number", "default": 100 },
    "enemy_hp_current": { "type": "number", "default": 100 },
    "damage_dealt": { "type": "number", "default": 0 },
    "damage_taken": { "type": "number", "default": 0 },
    "objective_progress": { "type": "number", "default": 0 },
    "objective_target": { "type": "number", "default": 1 },
    "card_snapshot": { "type": "array", "items": { "type": "object" }, "default": [] },
    "avatar_snapshot": { "type": "object", "default": {} },
    "rewards_applied": { "type": "boolean", "default": false },
    "reward_summary": { "type": "object", "default": {} },
    "last_action": { "type": "string" },
    "last_action_at": { "type": "string", "format": "date-time" }
  },
  "required": ["user_id", "mode", "activity_id", "status"],
  "rls": {
    "read": { "data.user_id": "{{user.id}}" },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}