{
  "name": "CardTrade",
  "type": "object",
  "properties": {
    "seller_id": { "type": "string" },
    "buyer_id": { "type": "string", "description": "Null until a buyer claims or completes the purchase" },
    "card_id": { "type": "string", "description": "Exact UserCard instance being traded" },
    "card_snapshot": {
      "type": "object",
      "description": "Full collectible and progression state at listing time",
      "properties": {
        "user_card_id": { "type": "string" },
        "trading_card_id": { "type": "string" },
        "passport_id": { "type": "string" },
        "name": { "type": "string" },
        "rarity": { "type": "string" },
        "playable_tier": { "type": "string" },
        "enhancement_percent": { "type": "number" },
        "ascension": { "type": "number" },
        "stack_level": { "type": "number" },
        "power_score": { "type": "number" },
        "mastery_visual": { "type": "string" },
        "mastery": { "type": "object" },
        "origin_game": { "type": "string" },
        "origin_achievement": { "type": "string" },
        "acquired_at": { "type": "string" },
        "image": { "type": "string" },
        "provenance_event_count": { "type": "number" },
        "provenance_head_hash": { "type": "string" },
        "external_ledger_status": { "type": "string" },
        "level": { "type": "number", "description": "Legacy listing compatibility" },
        "stars": { "type": "number", "description": "Legacy listing compatibility" },
        "enhanced_stats": { "type": "object", "description": "Legacy listing compatibility" }
      }
    },
    "listing_type": { "type": "string", "enum": ["fixed_price", "auction", "trade_offer"], "default": "fixed_price" },
    "asking_price": { "type": "number", "description": "Price in platform currency" },
    "asking_materials": {
      "type": "array",
      "items": { "type": "object", "properties": { "material_type": { "type": "string" }, "quantity": { "type": "number" } } },
      "description": "Materials requested for trade"
    },
    "market_value_score": { "type": "number", "description": "Calculated value at listing" },
    "status": { "type": "string", "enum": ["active", "processing", "sold", "cancelled", "expired"], "default": "active" },
    "settlement_key": { "type": "string", "description": "Stable idempotency key for one fixed-price purchase settlement." },
    "settlement_state": { "type": "string", "enum": ["processing", "completed", "needs_recovery"] },
    "settlement_started_at": { "type": "string", "format": "date-time" },
    "settlement_completed_at": { "type": "string", "format": "date-time" },
    "buyer_debited": { "type": "boolean", "default": false },
    "seller_credited": { "type": "boolean", "default": false },
    "card_transferred": { "type": "boolean", "default": false },
    "provenance_recorded": { "type": "boolean", "default": false },
    "transaction_recorded": { "type": "boolean", "default": false },
    "expires_at": { "type": "string", "format": "date-time" },
    "views": { "type": "number", "default": 0 },
    "trade_cooldown_until": { "type": "string", "format": "date-time", "description": "Anti-flip protection" }
  },
  "required": ["seller_id", "card_id", "listing_type"]
}
