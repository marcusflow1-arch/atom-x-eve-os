{
  "name": "VoiceSignal",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "offer",
        "answer",
        "ice",
        "decline",
        "hangup"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "channel_id",
    "sender_id",
    "target_id",
    "type",
    "payload"
  ],
  "rls": {
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.target_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.target_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.target_id": "{{user.id}}"
        }
      ]
    }
  }
}