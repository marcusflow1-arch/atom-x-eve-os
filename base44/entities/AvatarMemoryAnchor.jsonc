{
  "name": "AvatarMemoryAnchor",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "avatar_id": {
      "type": "string"
    },
    "experience_id": {
      "type": "string"
    },
    "anchor_type": {
      "type": "string",
      "enum": [
        "first",
        "turning_point",
        "value",
        "relationship",
        "failure",
        "victory",
        "aspiration",
        "preference",
        "self_definition"
      ],
      "default": "turning_point"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "strength": {
      "type": "number",
      "default": 50
    },
    "times_recalled": {
      "type": "number",
      "default": 0
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_recalled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "avatar_id",
    "experience_id",
    "anchor_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}