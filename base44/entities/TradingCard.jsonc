{
  "name": "TradingCard",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Unique"
      ]
    },
    "edition_size": {
      "type": "number"
    },
    "achievement_id": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "showcase": {
      "type": "object"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "ability",
        "equipment",
        "companion",
        "pet",
        "mount",
        "teacher",
        "material",
        "home_item",
        "environment",
        "collectible"
      ]
    },
    "game_id": {
      "type": "string"
    },
    "stats": {
      "type": "object"
    },
    "equip_slot": {
      "type": "string",
      "enum": [
        "head",
        "chest",
        "gloves",
        "boots",
        "pants",
        "cape",
        "weapon_main",
        "weapon_off",
        "artifact"
      ]
    },
    "animation_effect": {
      "type": "object"
    },
    "model_url": {
      "type": "string"
    },
    "home_item_key": {
      "type": "string"
    },
    "stackable": {
      "type": "boolean",
      "default": false
    },
    "tradable": {
      "type": "boolean",
      "default": true
    },
    "max_level": {
      "type": "number",
      "default": 50
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "live",
        "retired"
      ],
      "default": "live"
    }
  },
  "required": [
    "name",
    "image_url",
    "rarity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}