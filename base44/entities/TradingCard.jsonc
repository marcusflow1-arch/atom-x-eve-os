{
  "name": "TradingCard",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Unique"
      ]
    },
    "edition_size": {
      "type": "number",
      "description": "Total number of cards available (null for unlimited)"
    },
    "achievement_id": {
      "type": "string",
      "description": "Linked achievement ID"
    },
    "series": {
      "type": "string"
    },
    "showcase": {
      "type": "object",
      "description": "Public skill/item media used by the channel Cards showcase",
      "properties": {
        "model_url": {
          "type": "string",
          "description": "HTTPS URL for the GLB, GLTF, or FBX skill/item model"
        },
        "animation_clip": {
          "type": "string",
          "description": "Optional animation name to play from the model"
        },
        "video_url": {
          "type": "string",
          "description": "HTTPS gameplay demonstration video URL"
        }
      }
    }
  },
  "required": [
    "name",
    "image_url",
    "rarity"
  ]
}
