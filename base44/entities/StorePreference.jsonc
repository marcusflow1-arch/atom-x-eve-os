{
  "name": "StorePreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "played_game_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "use_play_history": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
