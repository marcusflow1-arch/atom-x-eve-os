{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "clanId": {
      "type": "string",
      "description": "ID of the clan this assignment belongs to"
    },
    "gameId": {
      "type": "string",
      "description": "ID of the game context"
    },
    "title": {
      "type": "string",
      "description": "Title or short description of the assignment"
    },
    "description": {
      "type": "string",
      "description": "Detailed instructions"
    },
    "targetId": {
      "type": "string",
      "description": "ID of the referenced objective or achievement"
    },
    "targetType": {
      "type": "string",
      "enum": [
        "objective",
        "achievement",
        "raid",
        "custom"
      ],
      "default": "custom",
      "description": "Type of the referenced target"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "assignedMemberIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of IDs of members assigned to this task"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Current status of the assignment"
    },
    "dueDate": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "auditLog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Log of status changes and actions"
    }
  },
  "required": [
    "clanId",
    "title",
    "priority",
    "status"
  ]
}