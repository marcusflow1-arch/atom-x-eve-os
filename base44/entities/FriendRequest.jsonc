{
  "name": "FriendRequest",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User ID who sent the request"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of sender"
    },
    "sender_avatar": {
      "type": "string",
      "description": "Avatar URL of sender"
    },
    "receiver_id": {
      "type": "string",
      "description": "User ID who receives the request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "message": {
      "type": "string",
      "description": "Optional message with request"
    }
  },
  "required": [
    "sender_id",
    "sender_name",
    "receiver_id"
  ]
}