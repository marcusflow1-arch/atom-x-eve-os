{
  "name": "Item",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Item name"
    },
    "description": {
      "type": "string",
      "description": "Item description"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Mythic"
      ],
      "description": "Item rarity tier"
    },
    "type": {
      "type": "string",
      "enum": [
        "Weapon",
        "Armor",
        "Trinket",
        "Companion Gear",
        "UI Skin",
        "Material"
      ],
      "description": "Item category"
    },
    "game_id": {
      "type": "string",
      "description": "ID of the source game"
    },
    "game_title": {
      "type": "string",
      "description": "Title of the source game"
    },
    "genre": {
      "type": "string",
      "enum": [
        "RPG",
        "MMO",
        "Action",
        "Sci-Fi",
        "Fantasy",
        "Adventure",
        "Shooter"
      ],
      "description": "Game genre"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "achievement",
            "drop",
            "craft"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "description": "How the item was acquired"
    },
    "set_id": {
      "type": "string",
      "description": "ID of the set this item belongs to (if any)"
    },
    "set_position": {
      "type": "number",
      "description": "Position within the set"
    },
    "base_stats": {
      "type": "object",
      "description": "Base item statistics"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Applied enchantments and modifiers"
    },
    "enchantment_slots": {
      "type": "number",
      "default": 0,
      "description": "Maximum enchantment slots"
    },
    "preview_image_url": {
      "type": "string",
      "description": "Item thumbnail/preview image"
    },
    "model_3d_url": {
      "type": "string",
      "description": "3D model URL (optional)"
    },
    "is_bound": {
      "type": "boolean",
      "default": true,
      "description": "Whether item is bound to account"
    },
    "level_requirement": {
      "type": "number",
      "default": 1,
      "description": "Minimum level to use item"
    }
  },
  "required": [
    "name",
    "rarity",
    "type",
    "game_id",
    "genre"
  ]
}