{
  "name": "AgentJob",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running"
    },
    "type": {
      "type": "string",
      "description": "Type of agent job (e.g. game_discovery)"
    },
    "summary": {
      "type": "string",
      "description": "Final result summary"
    }
  },
  "required": [
    "status",
    "type"
  ]
}