{
  "name": "GameKnowledge",
  "type": "object",
  "properties": {
    "game_name": {
      "type": "string",
      "description": "Name of the game/project analyzed"
    },
    "source_folder": {
      "type": "string",
      "description": "Original folder name that was analyzed"
    },
    "file_count": {
      "type": "number",
      "description": "Total files analyzed from this game"
    },
    "architecture_summary": {
      "type": "string",
      "description": "High-level architecture analysis of the entire game"
    },
    "tech_stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Detected technologies (e.g. Unreal Engine, Unity, C++, Blueprint)"
    },
    "systems_map": {
      "type": "string",
      "description": "Detailed breakdown of all game systems found (rendering, physics, AI, networking, etc.)"
    },
    "code_patterns": {
      "type": "string",
      "description": "Key coding patterns, design patterns, and architectural decisions"
    },
    "asset_pipeline": {
      "type": "string",
      "description": "How assets (models, textures, audio) are organized and loaded"
    },
    "gameplay_systems": {
      "type": "string",
      "description": "Gameplay mechanics, player controllers, AI behavior, combat systems"
    },
    "world_structure": {
      "type": "string",
      "description": "Level design, world building, scene graph, environment systems"
    },
    "rendering_info": {
      "type": "string",
      "description": "Shaders, materials, lighting, post-processing pipeline"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags for the game knowledge"
    },
    "status": {
      "type": "string",
      "enum": [
        "analyzing",
        "complete",
        "failed"
      ],
      "default": "analyzing"
    },
    "linked_knowledge_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of KnowledgeEntry records created from this game's files"
    }
  },
  "required": [
    "game_name",
    "source_folder"
  ]
}