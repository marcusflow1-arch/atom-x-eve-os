{
  "name": "UserEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who created the event"
    },
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "raid",
        "tournament",
        "meeting",
        "gaming_session",
        "personal",
        "reminder",
        "life",
        "story",
        "clan",
        "task"
      ],
      "default": "gaming_session"
    },
    "source": {
      "type": "string",
      "enum": [
        "user",
        "ai",
        "game",
        "clan"
      ],
      "default": "user"
    },
    "game": {
      "type": "string",
      "description": "Related game name"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Event start time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Event end time"
    },
    "recurrence": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ]
        },
        "interval": {
          "type": "number",
          "default": 1
        },
        "days_of_week": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "end_date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Recurrence rules for the event"
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_before": {
            "type": "number",
            "description": "Minutes before event"
          },
          "type": {
            "type": "string",
            "enum": [
              "notification",
              "email",
              "ai_voice"
            ]
          }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of participant user IDs"
    },
    "linked_game_id": {
      "type": "string"
    },
    "linked_story_id": {
      "type": "string"
    },
    "linked_task_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false
    },
    "reward_type": {
      "type": "string",
      "description": "What this event unlocks"
    },
    "affected_system": {
      "type": "string",
      "description": "Which AI system is affected"
    },
    "memory_flag": {
      "type": "boolean",
      "default": false,
      "description": "Whether this event creates a permanent memory"
    }
  },
  "required": [
    "user_id",
    "title",
    "start_time"
  ]
}