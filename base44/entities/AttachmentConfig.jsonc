{
  "name": "AttachmentConfig",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "description": "ID of the Model3D character this config applies to"
    },
    "model_name": {
      "type": "string",
      "description": "Display name of the model"
    },
    "object_label": {
      "type": "string",
      "description": "Label of the attached object (e.g. 'Sword', 'Shield')"
    },
    "object_url": {
      "type": "string",
      "description": "URL of the 3D object file (GLB/FBX)"
    },
    "object_type": {
      "type": "string",
      "enum": [
        "weapon",
        "effect",
        "accessory"
      ],
      "default": "weapon"
    },
    "bone_name": {
      "type": "string",
      "description": "Bone to attach to (e.g. mixamorigRightHand)"
    },
    "animation_name": {
      "type": "string",
      "description": "Animation name this config applies to (e.g. 'Idle', 'Standing Melee Kick'). Use '*' for default/fallback."
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "If true, this is the fallback config used when no animation-specific config matches"
    },
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "z": {
          "type": "number",
          "default": 0
        }
      },
      "default": {
        "x": 0,
        "y": 0,
        "z": 0
      }
    },
    "rotation": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "z": {
          "type": "number",
          "default": 0
        }
      },
      "default": {
        "x": 0,
        "y": 0,
        "z": 0
      }
    },
    "scale": {
      "type": "number",
      "default": 50
    },
    "trigger_time": {
      "type": "number",
      "default": 0,
      "description": "Normalized time (seconds) when this config activates during the animation. 0 = from start."
    },
    "visible_when_unequipped": {
      "type": "boolean",
      "default": true,
      "description": "Whether the object is visible when not equipped"
    },
    "unequipped_bone": {
      "type": "string",
      "description": "Bone to attach to when not equipped (e.g. back/spine). Empty = same bone."
    },
    "unequipped_position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "z": {
          "type": "number",
          "default": 0
        }
      }
    },
    "unequipped_rotation": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "default": 0
        },
        "y": {
          "type": "number",
          "default": 0
        },
        "z": {
          "type": "number",
          "default": 0
        }
      }
    },
    "linked_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect_label": {
            "type": "string"
          },
          "effect_url": {
            "type": "string"
          },
          "bone_name": {
            "type": "string"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "rotation": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          },
          "scale": {
            "type": "number",
            "default": 30
          },
          "trigger_time": {
            "type": "number",
            "default": 0
          },
          "duration": {
            "type": "number",
            "default": 1
          }
        }
      },
      "default": [],
      "description": "Effects that appear alongside this attachment during this animation"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "model_id",
    "object_label",
    "bone_name",
    "animation_name"
  ]
}