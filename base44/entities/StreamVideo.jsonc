{
  "name": "StreamVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "description": {
      "type": "string",
      "description": "Video description"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Video thumbnail image URL"
    },
    "video_url": {
      "type": "string",
      "description": "Stored video file URL"
    },
    "duration": {
      "type": "number",
      "description": "Video duration in seconds"
    },
    "game_category": {
      "type": "string",
      "description": "Game being streamed/recorded"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "draft"
      ],
      "default": "private",
      "description": "Video visibility setting"
    },
    "stream_type": {
      "type": "string",
      "enum": [
        "live_stream",
        "recording",
        "upload"
      ],
      "description": "How the video was created"
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "Number of views"
    },
    "uploaded_platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "platform_id": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "description": "External platforms where video was uploaded"
    },
    "stream_settings": {
      "type": "object",
      "properties": {
        "bitrate": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "has_camera": {
          "type": "boolean"
        },
        "has_mic": {
          "type": "boolean"
        }
      },
      "description": "Technical stream settings"
    }
  },
  "required": [
    "title",
    "video_url",
    "duration",
    "stream_type"
  ]
}