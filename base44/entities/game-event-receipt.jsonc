{
  "name": "GameEventReceipt",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "achievement_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "processed_achievement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "game_id",
    "event_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
