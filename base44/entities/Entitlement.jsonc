{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "game",
        "dlc"
      ]
    },
    "item_id": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "stripe",
        "free",
        "admin_grant",
        "migration"
      ]
    },
    "order_id": {
      "type": "string"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "item_type",
    "item_id",
    "source"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}