{
  "name": "FarmRoute",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "ID of the game context"
    },
    "gameId": {
      "type": "string",
      "description": "Legacy ID of the game context"
    },
    "title": {
      "type": "string",
      "description": "Title of the farming route"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "video_url": {
      "type": "string",
      "description": "URL to a video guide (YouTube, etc.)"
    },
    "tactics": {
      "type": "string",
      "description": "Step-by-step tactics and strategy notes"
    },
    "route_type": {
      "type": "string",
      "enum": [
        "resource",
        "boss",
        "xp",
        "achievement",
        "speedrun",
        "other"
      ],
      "default": "resource",
      "description": "Type of farm route"
    },
    "type": {
      "type": "string",
      "enum": [
        "Resource",
        "XP",
        "Boss",
        "Currency",
        "Other"
      ],
      "default": "Resource",
      "description": "Legacy type field"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "extreme"
      ],
      "default": "medium"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "clan"
      ],
      "default": "public",
      "description": "Who can see this route"
    },
    "clan_id": {
      "type": "string",
      "description": "ID of the clan"
    },
    "clanId": {
      "type": "string",
      "description": "Legacy clan ID"
    },
    "author_id": {
      "type": "string",
      "description": "ID of the creator"
    },
    "authorId": {
      "type": "string",
      "description": "Legacy ID of the creator"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of creator"
    },
    "authorName": {
      "type": "string",
      "description": "Legacy display name"
    },
    "imageUrl": {
      "type": "string",
      "description": "Optional map or screenshot"
    },
    "yields": {
      "type": "string",
      "description": "Estimated yield (e.g. '500 Iron/hr')"
    }
  },
  "required": [
    "title"
  ]
}