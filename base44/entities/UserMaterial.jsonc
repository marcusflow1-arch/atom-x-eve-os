{
  "name": "UserMaterial",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of this material stack"
    },
    "material_id": {
      "type": "string",
      "description": "Reference to Material entity"
    },
    "material_type": {
      "type": "string",
      "description": "Cached material type for quick filtering"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "card_consumption_receipts": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Idempotency receipts for enhancement materials consumed by Card System v2 mutations."
    },
    "source_game": {
      "type": "string",
      "description": "Game title where material was earned"
    },
    "source_achievement": {
      "type": "string",
      "description": "Achievement that granted this material"
    },
    "is_tradable": {
      "type": "boolean",
      "default": true
    }
  },
  "required": ["user_id", "material_id", "quantity"],
  "rls": {
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
