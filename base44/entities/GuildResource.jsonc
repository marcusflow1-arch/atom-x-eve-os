{
  "name": "GuildResource",
  "type": "object",
  "properties": {
    "guild_id": {
      "type": "string",
      "description": "ID of the guild"
    },
    "contributor_id": {
      "type": "string",
      "description": "ID of the user who contributed"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "gold",
        "material",
        "item"
      ],
      "description": "Type of resource"
    },
    "amount": {
      "type": "number",
      "description": "Amount of resource (for gold/materials)"
    },
    "item_id": {
      "type": "string",
      "description": "ID of item if type is item"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "guild_id",
    "resource_type"
  ]
}