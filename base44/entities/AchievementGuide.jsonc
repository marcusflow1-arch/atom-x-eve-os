{
  "name": "AchievementGuide",
  "type": "object",
  "properties": {
    "achievement_id": {
      "type": "string",
      "description": "The ID of the achievement this guide is for."
    },
    "title": {
      "type": "string",
      "description": "Title of the guide or tip."
    },
    "content": {
      "type": "string",
      "description": "The main body of the guide."
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of URLs for screenshots or videos."
    },
    "upvoter_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of user IDs who upvoted this guide."
    },
    "downvoter_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of user IDs who downvoted this guide."
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Threaded comments on this guide."
    },
    "moderation_state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "community_verified"
      ],
      "default": "pending"
    }
  },
  "required": [
    "achievement_id",
    "content"
  ]
}