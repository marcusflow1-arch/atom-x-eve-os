{
  "name": "Memory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Creator ID"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "game_name": {
      "type": "string"
    },
    "ai_analysis": {
      "type": "object",
      "description": "AI insight with ability and message"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "comments_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "media_url"
  ]
}