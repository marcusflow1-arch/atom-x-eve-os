{
  "name": "Strategy",
  "type": "object",
  "properties": {
    "clan_id": {
      "type": "string",
      "description": "Clan owning this strategy"
    },
    "game_id": {
      "type": "string",
      "description": "Game context"
    },
    "title": {
      "type": "string",
      "description": "Strategy title"
    },
    "summary": {
      "type": "string",
      "description": "Short summary"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Step-by-step guide"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "voice_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "visibility": {
      "type": "string",
      "enum": [
        "clan",
        "public"
      ],
      "default": "clan"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "clan_id",
    "game_id",
    "title"
  ]
}