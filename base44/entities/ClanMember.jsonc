{
  "name": "ClanMember",
  "type": "object",
  "properties": {
    "clan_id": {
      "type": "string",
      "description": "ID of the clan"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the user"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "officer",
        "leader"
      ],
      "default": "member",
      "description": "Role of the user in the clan"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user joined the clan"
    },
    "last_active": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the user was active in clan context"
    },
    "nickname": {
      "type": "string",
      "description": "User-defined display nickname within the clan"
    },
    "title": {
      "type": "string",
      "description": "Clan title assigned by leader/officer (e.g., Raid Captain, Strategist)"
    }
  },
  "required": [
    "clan_id",
    "user_id",
    "role"
  ]
}