{
  "name": "AchievementPath",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the pathway (e.g., 'The Warrior's Way')"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "combat",
        "exploration",
        "social",
        "crafting",
        "collection"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "achievement_id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "nodes",
    "connections"
  ]
}