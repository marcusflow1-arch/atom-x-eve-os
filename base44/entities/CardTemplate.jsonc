{
  "name": "CardTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the card"
    },
    "description": {
      "type": "string",
      "description": "Flavor text and description"
    },
    "image_url": {
      "type": "string",
      "description": "Card artwork URL"
    },
    "type": {
      "type": "string",
      "enum": [
        "Ability",
        "Item",
        "Equipment",
        "Passive",
        "AI_Trait",
        "AI_Teacher"
      ],
      "description": "Type of card"
    },
    "base_rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Mythic"
      ]
    },
    "source_game_id": {
      "type": "string",
      "description": "Game ID this card belongs to"
    },
    "base_stats": {
      "type": "object",
      "description": "Starting stats at level 1"
    },
    "max_level": {
      "type": "number",
      "default": 100
    },
    "possible_synergies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "type",
    "base_rarity",
    "source_game_id"
  ]
}