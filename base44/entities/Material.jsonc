{
  "name": "Material",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Material name"
    },
    "type": {
      "type": "string",
      "enum": [
        "precision_shard",
        "combat_core",
        "ascension_core",
        "skill_catalyst",
        "resonance_fragment",
        "efficiency_module",
        "discovery_relic",
        "lore_catalyst",
        "fusion_currency",
        "competitive_token",
        "wildcard",
        "adaptive_shard"
      ],
      "description": "Material type determining usage"
    },
    "genre_origin": {
      "type": "string",
      "enum": [
        "action",
        "shooter",
        "rpg",
        "jrpg",
        "strategy",
        "simulation",
        "adventure",
        "exploration",
        "multiplayer",
        "competitive",
        "indie",
        "experimental"
      ],
      "description": "Game genre this material drops from"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary"
      ],
      "default": "Common"
    },
    "quality": {
      "type": "number",
      "default": 1,
      "description": "Quality tier 1-5 based on achievement difficulty"
    },
    "icon": {
      "type": "string",
      "description": "Emoji or icon URL"
    },
    "description": {
      "type": "string"
    },
    "use_category": {
      "type": "string",
      "enum": [
        "enhancement",
        "leveling",
        "ascension",
        "combination",
        "passive",
        "wildcard"
      ],
      "description": "Primary upgrade system this material is used for"
    },
    "base_value": {
      "type": "number",
      "default": 10,
      "description": "Base trade value"
    }
  },
  "required": [
    "name",
    "type",
    "genre_origin",
    "rarity"
  ]
}