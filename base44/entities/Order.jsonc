{
  "name": "Order",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who placed the order"
    },
    "total_amount": {
      "type": "number",
      "description": "Total cost of the order"
    },
    "currency": {
      "type": "string",
      "default": "AGP",
      "description": "Currency used"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending",
      "description": "Current status of the order"
    },
    "items": {
      "type": "array",
      "description": "List of items in the order",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "image": {
            "type": "string"
          }
        }
      }
    },
    "shipping_info": {
      "type": "object",
      "description": "Shipping and contact details",
      "properties": {
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "transaction_id": {
      "type": "string",
      "description": "Payment gateway transaction ID"
    }
  },
  "required": [
    "user_id",
    "total_amount",
    "items",
    "status"
  ]
}