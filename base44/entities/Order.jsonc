{
  "name": "Order",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "total_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "item_type": {
            "type": "string",
            "enum": [
              "game",
              "dlc"
            ]
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "image": {
            "type": "string"
          },
          "starter_card_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "transaction_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "checkout_key": {
      "type": "string"
    },
    "checkout_success_url": {
      "type": "string"
    },
    "checkout_cancel_url": {
      "type": "string"
    },
    "fulfillment_version": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ]
    },
    "fulfilled_item_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "fulfilled_at": {
      "type": "string",
      "format": "date-time"
    },
    "fulfillment_lock_token": {
      "type": "string"
    },
    "fulfillment_lock_until": {
      "type": "number"
    },
    "legacy_rewards_unverified": {
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "total_amount",
    "items",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
