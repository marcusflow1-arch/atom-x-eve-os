{
  "name": "Avatar",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The ID of the user this avatar belongs to. Each user has one avatar."
    },
    "name": {
      "type": "string",
      "description": "The avatar name chosen by the user."
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "experience": {
      "type": "number",
      "default": 0
    },
    "social_influence": {
      "type": "number",
      "default": 0
    },
    "reputation_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "model_url": {
      "type": "string",
      "default": "base_humanoid.glb"
    },
    "skin_tone": {
      "type": "string",
      "default": "#ffdbac"
    },
    "hair_color": {
      "type": "string",
      "default": "#111111"
    },
    "equipped_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "unlocked_abilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "active_companions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "morph_targets": {
      "type": "object",
      "default": {}
    },
    "current_mode": {
      "type": "string",
      "enum": [
        "Idle",
        "Story",
        "Battle",
        "Adaptive"
      ],
      "default": "Idle"
    },
    "active_memory_id": {
      "type": "string"
    },
    "setup_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete"
      ]
    },
    "setup_version": {
      "type": "number"
    },
    "personality": {
      "type": "string",
      "enum": [
        "calm",
        "warm",
        "curious"
      ]
    },
    "voice": {
      "type": "object"
    },
    "material_colors": {
      "type": "object",
      "default": {}
    },
    "height_scale": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "user_id",
    "name",
    "gender"
  ]
}