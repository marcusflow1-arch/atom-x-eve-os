{
  "name": "ClanFormMessage",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string",
      "description": "Topic this message belongs to"
    },
    "game_id": {
      "type": "string",
      "description": "Game ID this message belongs to"
    },
    "user_id": {
      "type": "string",
      "description": "Author user ID"
    },
    "clan_id": {
      "type": "string",
      "description": "Author clan ID"
    },
    "username": {
      "type": "string",
      "description": "Cached username for display"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    }
  },
  "required": [
    "topic_id",
    "user_id",
    "content"
  ]
}