{
  "name": "EnvironmentImprint",
  "type": "object",
  "properties": {
    "source_environment_id": {
      "type": "string",
      "description": "The EnvironmentInstance ID this imprint was created from"
    },
    "creator_id": {
      "type": "string",
      "description": "User ID who created/sold this imprint"
    },
    "buyer_id": {
      "type": "string",
      "description": "User ID who purchased this imprint (null if unsold)"
    },
    "name": {
      "type": "string",
      "description": "Name of the imprinted environment"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Mythical"
      ],
      "default": "Mythical",
      "description": "Only Mythical environments can be imprinted"
    },
    "environment_rank": {
      "type": "number",
      "description": "The rank at which the imprint was created (must be max)"
    },
    "structure_levels": {
      "type": "object",
      "description": "Snapshot of structure levels at time of imprint"
    },
    "cosmetic_state": {
      "type": "object",
      "description": "Snapshot of visual customization at time of imprint"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Preview thumbnail"
    },
    "model_url": {
      "type": "string",
      "description": "URL to the 3D model"
    },
    "imprint_version": {
      "type": "number",
      "default": 1,
      "description": "Version number of this imprint"
    },
    "status": {
      "type": "string",
      "enum": [
        "listed",
        "sold",
        "unlisted"
      ],
      "default": "unlisted",
      "description": "Market listing status"
    },
    "price": {
      "type": "number",
      "description": "Listed price in AGP"
    }
  },
  "required": [
    "source_environment_id",
    "creator_id",
    "name",
    "environment_rank"
  ]
}