{
  "name": "Contract",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "game_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "tokens": {
      "type": "number"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "completed",
        "cancelled"
      ],
      "default": "active"
    },
    "assignee_id": {
      "type": "string"
    }
  },
  "required": [
    "creator_id",
    "game_name",
    "tokens"
  ]
}