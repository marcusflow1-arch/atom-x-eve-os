{
  "name": "SocialFriendship",
  "type": "object",
  "properties": {
    "user_a_id": {
      "type": "string",
      "description": "First user in the friendship"
    },
    "user_a_name": {
      "type": "string"
    },
    "user_b_id": {
      "type": "string",
      "description": "Second user in the friendship"
    },
    "user_b_name": {
      "type": "string"
    }
  },
  "required": [
    "user_a_id",
    "user_b_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_a_id": "{{user.id}}"
        },
        {
          "user_b_id": "{{user.id}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_a_id": "{{user.id}}"
        },
        {
          "user_b_id": "{{user.id}}"
        }
      ]
    }
  }
}