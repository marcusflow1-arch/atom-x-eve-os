{
  "name": "WorldEvent",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Monster",
        "Chest",
        "Boss",
        "Player"
      ],
      "description": "The type of event on the map"
    },
    "name": {
      "type": "string",
      "description": "Name of the monster, chest, or player"
    },
    "description": {
      "type": "string",
      "description": "Flavor text or details"
    },
    "latitude": {
      "type": "number",
      "description": "Map latitude location"
    },
    "longitude": {
      "type": "number",
      "description": "Map longitude location"
    },
    "level": {
      "type": "number",
      "description": "Level of the monster or requirement"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Easy",
        "Medium",
        "Hard",
        "Boss",
        "None"
      ],
      "default": "Medium"
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Potential rewards"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Defeated",
        "Looted"
      ],
      "default": "Active"
    }
  },
  "required": [
    "type",
    "name",
    "latitude",
    "longitude"
  ]
}