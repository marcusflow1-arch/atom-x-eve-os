{
  "name": "ItemSet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Set name"
    },
    "description": {
      "type": "string",
      "description": "Set lore/description"
    },
    "piece_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of item IDs that belong to this set"
    },
    "bonuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pieces_required": {
            "type": "number"
          },
          "bonus_description": {
            "type": "string"
          },
          "bonus_stats": {
            "type": "object"
          }
        }
      },
      "description": "Set bonuses by piece count"
    },
    "rules": {
      "type": "object",
      "properties": {
        "distinct_games_required": {
          "type": "number",
          "default": 0
        },
        "allowed_genres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "same_genre_required": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Set assembly rules"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Mythic"
      ],
      "description": "Set rarity"
    },
    "theme": {
      "type": "string",
      "description": "Set theme or category"
    }
  },
  "required": [
    "name",
    "piece_ids",
    "bonuses"
  ]
}