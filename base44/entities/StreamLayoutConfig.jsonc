{
  "name": "StreamLayoutConfig",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "layout_version": {
      "type": "number",
      "default": 1,
      "description": "Version counter to prevent overwriting newer configs"
    },
    "stream_box": {
      "type": "object",
      "properties": {
        "col_span": {
          "type": "number",
          "default": 9
        },
        "border_style": {
          "type": "string",
          "enum": [
            "none",
            "subtle",
            "glow",
            "neon"
          ],
          "default": "subtle"
        },
        "glow_enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Stream player box configuration"
    },
    "chat_box": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "boolean",
          "default": true
        },
        "position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right"
        },
        "opacity": {
          "type": "number",
          "default": 100
        },
        "theme": {
          "type": "string",
          "enum": [
            "default",
            "dark",
            "glass",
            "neon"
          ],
          "default": "default"
        }
      },
      "description": "Chat box configuration"
    },
    "sections_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "schedule",
        "cards",
        "gallery",
        "games",
        "sponsors",
        "products",
        "seasonpass"
      ],
      "description": "Order of content sections below the stream"
    },
    "profile_theme": {
      "type": "string",
      "enum": [
        "default",
        "dark",
        "glass",
        "neon",
        "minimal"
      ],
      "default": "default",
      "description": "Overall page theme"
    },
    "schedule_data": {
      "type": "object",
      "default": {},
      "description": "Schedule entries keyed by date string YYYY-MM-DD"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Gallery image URLs"
    },
    "pinned_games": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of game titles pinned to profile"
    }
  },
  "required": [
    "user_id"
  ]
}