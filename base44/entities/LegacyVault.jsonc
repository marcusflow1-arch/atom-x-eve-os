{
  "name": "LegacyVault",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Archived record display name (prefixed)"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Model3DScript",
        "SceneLayout",
        "Other"
      ],
      "description": "Original entity type"
    },
    "original_id": {
      "type": "string",
      "description": "Original record ID"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reasons for quarantine"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_snapshot": {
      "type": "object",
      "description": "Full original record snapshot"
    }
  },
  "required": [
    "entity_type",
    "original_id",
    "archived_at"
  ]
}