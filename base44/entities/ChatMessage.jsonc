{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "description": "ID of the channel/zone this message belongs to. Ensures boundary."
    },
    "sender_id": {
      "type": "string",
      "description": "ID of the user who sent the message"
    },
    "sender_role": {
      "type": "string",
      "description": "Role of the sender at the time of messaging (e.g., member, officer, leader)",
      "enum": [
        "member",
        "officer",
        "leader",
        "system"
      ]
    },
    "content": {
      "type": "string",
      "description": "The message content"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "system",
        "image",
        "reply"
      ],
      "default": "text"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft deletion flag"
    },
    "deleted_by": {
      "type": "string",
      "description": "ID of the moderator who deleted the message"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "reply_to_id": {
      "type": "string",
      "description": "ID of the message this is a reply to"
    }
  },
  "required": [
    "channel_id",
    "sender_id",
    "content",
    "type"
  ]
}