{
  "name": "Game",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "original_year": {
      "type": "number"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "genre": {
      "type": "string",
      "enum": [
        "shooting",
        "fighting",
        "sci-fi",
        "mmo",
        "mmorpg",
        "adventure",
        "action",
        "fantasy",
        "rpg",
        "strategy",
        "simulation",
        "sports",
        "racing",
        "horror",
        "puzzle",
        "platformer",
        "survival",
        "open_world",
        "sandbox",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "reconstructed",
        "in_development",
        "planned",
        "available"
      ],
      "default": "available"
    },
    "cover_image": {
      "type": "string"
    },
    "banner_image": {
      "type": "string"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trailer_url": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "play_link": {
      "type": "string"
    },
    "system_requirements": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "starter_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "title",
    "description",
    "genre",
    "status",
    "cover_image"
  ]
}