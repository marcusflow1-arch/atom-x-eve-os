{
  "name": "Game",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Game title"
    },
    "description": {
      "type": "string",
      "description": "Detailed game description"
    },
    "original_year": {
      "type": "number",
      "description": "Original release year"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Confirmed release date (YYYY-MM-DD), used for Aura's release discovery lane"
    },
    "genre": {
      "type": "string",
      "enum": [
        "shooting",
        "fighting",
        "sci-fi",
        "mmo",
        "mmorpg",
        "adventure",
        "action",
        "fantasy",
        "rpg",
        "strategy",
        "simulation",
        "sports",
        "racing",
        "horror",
        "puzzle",
        "platformer",
        "survival",
        "open_world",
        "sandbox",
        "other"
      ],
      "description": "Primary genre of the game"
    },
    "status": {
      "type": "string",
      "enum": [
        "reconstructed",
        "in_development",
        "planned",
        "available"
      ],
      "default": "available"
    },
    "cover_image": {
      "type": "string",
      "description": "URL for the game's primary cover image"
    },
    "banner_image": {
      "type": "string",
      "description": "URL for the game's wide banner/background image"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of URLs for game screenshots"
    },
    "video_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of URLs for game videos/trailers (YouTube, etc.)"
    },
    "trailer_url": {
      "type": "string",
      "description": "URL for the game's main trailer (Legacy)"
    },
    "price": {
      "type": "number",
      "description": "Price of the game in USD"
    },
    "play_link": {
      "type": "string",
      "description": "URL or command to launch the game"
    },
    "system_requirements": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "processor": {
          "type": "string"
        },
        "memory": {
          "type": "string"
        },
        "graphics": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags for categorization"
    },
    "short_description": {
      "type": "string",
      "description": "Compact store summary used beside the game media"
    },
    "developer": {
      "type": "string",
      "description": "Primary development studio"
    },
    "developerKey": {
      "type": "string",
      "description": "Optional developer/studio profile key"
    },
    "publisher": {
      "type": "string",
      "description": "Publisher of record"
    },
    "about_game": {
      "type": "string",
      "description": "Developer-authored About This Game marketing/editorial copy"
    },
    "development_history": {
      "type": "string",
      "description": "Developer-authored development history, production background, or project story"
    },
    "developer_message": {
      "type": "string",
      "description": "Optional developer message or promotional note shown on the game landing page"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Developer-published feature highlights"
    }
  },
  "required": [
    "title",
    "description",
    "genre",
    "status",
    "cover_image"
  ]
}