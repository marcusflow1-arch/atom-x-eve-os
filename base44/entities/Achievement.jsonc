{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The official name of the achievement."
    },
    "description": {
      "type": "string",
      "description": "How to unlock the achievement and its lore."
    },
    "game": {
      "type": "string",
      "description": "The name of the game this achievement belongs to (e.g., 'Cyberpunk 2088')."
    },
    "category": {
      "type": "string",
      "enum": [
        "standard",
        "ability",
        "emoji",
        "dance",
        "equipment",
        "companion",
        "environment",
        "hidden"
      ],
      "description": "The type of achievement, determining the reward category."
    },
    "rarity": {
      "type": "string",
      "enum": [
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Mythical",
        "Unique",
        "Limitless"
      ],
      "description": "The rarity tier of the achievement, from Common to Limitless."
    },
    "points": {
      "type": "number",
      "description": "The amount of Gamer Score or XP awarded upon unlock."
    },
    "icon": {
      "type": "string",
      "description": "An emoji or icon representing the achievement."
    },
    "reward": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "The type of reward, e.g., 'Legendary Sword', 'Fireball Spell', 'Environment Map'."
        },
        "name": {
          "type": "string",
          "description": "The name of the unlocked item or ability."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the reward."
        },
        "stats": {
          "type": "object",
          "description": "For equipment: stats like Attack, Defense. (e.g., {\"Attack\": 50, \"Speed\": 10})."
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For abilities: a list of special effects or moves."
        },
        "environment_id": {
          "type": "string",
          "description": "For environment achievements: the ID of the environment/map unlocked."
        },
        "environment_thumbnail": {
          "type": "string",
          "description": "For environment achievements: thumbnail image of the environment."
        }
      },
      "description": "The tangible reward unlocked by the achievement."
    }
  },
  "required": [
    "title",
    "description",
    "game",
    "category",
    "rarity",
    "points",
    "icon"
  ]
}