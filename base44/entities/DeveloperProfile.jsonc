{
  "name": "DeveloperProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Linked user ID"
    },
    "studio_name": {
      "type": "string",
      "description": "Studio or developer display name"
    },
    "tagline": {
      "type": "string",
      "description": "Short catchy tagline"
    },
    "bio": {
      "type": "string",
      "description": "Full developer bio"
    },
    "avatar_url": {
      "type": "string",
      "description": "Developer avatar/photo URL"
    },
    "banner_url": {
      "type": "string",
      "description": "Wide studio banner image URL"
    },
    "location": {
      "type": "string"
    },
    "founded_year": {
      "type": "number"
    },
    "team_size": {
      "type": "string",
      "enum": [
        "Solo",
        "Indie (2-5)",
        "Small Studio (6-20)",
        "Mid Studio (21-100)",
        "AAA (100+)"
      ]
    },
    "current_project": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Pre-Production",
            "In Development",
            "Alpha",
            "Beta",
            "Polishing",
            "Shipped"
          ]
        },
        "progress": {
          "type": "number"
        },
        "image_url": {
          "type": "string"
        },
        "expected_release": {
          "type": "string"
        }
      }
    },
    "social_links": {
      "type": "object",
      "properties": {
        "twitter": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "twitch": {
          "type": "string"
        },
        "discord": {
          "type": "string"
        },
        "website": {
          "type": "string"
        }
      }
    },
    "is_live": {
      "type": "boolean",
      "default": false
    },
    "stream_url": {
      "type": "string",
      "description": "Live stream embed URL if currently live"
    },
    "stream_title": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dev tools used (Unity, Unreal, Godot...)"
    },
    "total_games": {
      "type": "number",
      "default": 0
    },
    "total_cards": {
      "type": "number",
      "default": 0
    },
    "followers": {
      "type": "number",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "studio_name"
  ]
}