{
  "name": "AuraStreamSchedule",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User entity"
    },
    "title": {
      "type": "string",
      "description": "Scheduled stream title"
    },
    "game_id": {
      "type": "string",
      "description": "Game to be streamed"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled start time"
    },
    "scheduled_end": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled end time"
    },
    "send_notification": {
      "type": "boolean",
      "default": true,
      "description": "Send notification to followers"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "live",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "user_id",
    "title",
    "scheduled_start"
  ]
}