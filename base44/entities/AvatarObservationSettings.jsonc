{
  "name": "AvatarObservationSettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "avatar_id": {
      "type": "string"
    },
    "game_event_learning": {
      "type": "boolean",
      "default": true
    },
    "screen_observation_enabled": {
      "type": "boolean",
      "default": false
    },
    "screen_sample_seconds": {
      "type": "number",
      "default": 12
    },
    "store_frames": {
      "type": "boolean",
      "default": false,
      "description": "If false, frames are analyzed transiently and only structured observations are stored"
    },
    "coach_feedback_enabled": {
      "type": "boolean",
      "default": true
    },
    "reflection_questions_enabled": {
      "type": "boolean",
      "default": true
    },
    "reflection_frequency": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "last_screen_session_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "avatar_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}