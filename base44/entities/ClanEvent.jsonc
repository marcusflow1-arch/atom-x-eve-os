{
  "name": "ClanEvent",
  "type": "object",
  "properties": {
    "divisionId": {
      "type": "string"
    },
    "creatorId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "raid",
        "dungeon",
        "pvp",
        "casual",
        "meeting",
        "tournament"
      ],
      "default": "casual"
    },
    "startTime": {
      "type": "string",
      "format": "date-time"
    },
    "maxParticipants": {
      "type": "number",
      "default": 4
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of User IDs who joined"
    },
    "game": {
      "type": "string",
      "description": "Game this event is for"
    }
  },
  "required": [
    "divisionId",
    "title",
    "startTime"
  ]
}