{
  "name": "Party",
  "type": "object",
  "properties": {
    "clanId": {
      "type": "string",
      "description": "ID of the clan"
    },
    "gameId": {
      "type": "string",
      "description": "ID of the game context"
    },
    "leaderId": {
      "type": "string",
      "description": "ID of the party leader"
    },
    "goal": {
      "type": "string",
      "description": "Objective or farming target"
    },
    "description": {
      "type": "string",
      "description": "Additional details about the party's plan"
    },
    "maxSize": {
      "type": "number",
      "default": 4,
      "description": "Maximum number of members"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of user IDs currently in the party"
    },
    "assignmentId": {
      "type": "string",
      "description": "Linked clan assignment ID (optional)"
    },
    "voiceRoomId": {
      "type": "string",
      "description": "Linked voice room ID (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "forming",
        "full",
        "active",
        "completed"
      ],
      "default": "forming",
      "description": "Current status of the party"
    },
    "micRequired": {
      "type": "boolean",
      "default": false
    },
    "lastActive": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last activity/update"
    }
  },
  "required": [
    "clanId",
    "gameId",
    "leaderId",
    "goal"
  ]
}