{
  "name": "Comment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "The ID of the post this comment belongs to (Deprecated)"
    },
    "target_id": {
      "type": "string",
      "description": "ID of the target entity"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "post",
        "memory",
        "contract",
        "clip",
        "clip_request"
      ],
      "default": "post"
    },
    "user_id": {
      "type": "string",
      "description": "ID of the commenter"
    },
    "content": {
      "type": "string",
      "description": "The text of the comment"
    },
    "score": {
      "type": "number",
      "default": 1,
      "description": "The total score of the comment (upvotes - downvotes)"
    },
    "channel_id": {
      "type": "string",
      "description": "Channel owner ID for Gallery comments and clip requests"
    },
    "clip_id": {
      "type": "string",
      "description": "Stable Gallery media ID"
    },
    "clip_title": {
      "type": "string",
      "description": "Title of the requested or discussed Gallery moment"
    },
    "author_name": {
      "type": "string",
      "description": "Public display name shown in the clip discussion"
    }
  },
  "required": [
    "content"
  ]
}
