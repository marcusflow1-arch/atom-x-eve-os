{
  "name": "Comment",
  "type": "object",
  "properties": {
    "post_id": { "type": "string", "description": "Deprecated post reference" },
    "target_id": { "type": "string", "description": "ID of the target entity" },
    "target_type": { "type": "string", "enum": ["post", "memory", "contract", "clip", "clip_request"], "default": "post" },
    "user_id": { "type": "string", "description": "Stable owner user id" },
    "author_name": { "type": "string", "description": "Public display name snapshot" },
    "content": { "type": "string", "description": "The text of the comment" },
    "parent_comment_id": { "type": "string", "description": "Optional parent for threaded replies" },
    "score": { "type": "number", "default": 1, "description": "Legacy score retained for compatibility" },
    "status": { "type": "string", "enum": ["published", "removed"], "default": "published" },
    "edited_at": { "type": "string" },
    "channel_id": { "type": "string" },
    "clip_id": { "type": "string" },
    "clip_title": { "type": "string" }
  },
  "required": ["content"]
}
