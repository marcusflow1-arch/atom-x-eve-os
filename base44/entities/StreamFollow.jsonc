{
  "name": "StreamFollow",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user following"
    },
    "streamer_id": {
      "type": "string",
      "description": "ID of the streamer being followed"
    },
    "notification_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to notify when streamer goes live"
    }
  },
  "required": [
    "user_id",
    "streamer_id"
  ]
}