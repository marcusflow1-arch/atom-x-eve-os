{
  "name": "AIBattleQueue",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Player waiting in AI Battle matchmaking."
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "matched",
        "cancelled"
      ],
      "default": "waiting"
    },
    "route_id": {
      "type": "string",
      "default": "duel"
    },
    "world_id": {
      "type": "string"
    },
    "world": {
      "type": "object"
    },
    "player_snapshot": {
      "type": "object",
      "description": "Server-authored immutable player/Jawan/card snapshot captured when queueing."
    },
    "matched_encounter_id": {
      "type": "string"
    },
    "matched_user_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "queued_at": {
      "type": "string",
      "format": "date-time"
    },
    "matched_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "status",
    "route_id",
    "player_snapshot"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}