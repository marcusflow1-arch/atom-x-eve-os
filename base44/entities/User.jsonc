{
  "name": "User",
  "type": "object",
  "properties": {
    "presence_status": {
      "type": "string",
      "enum": [
        "online",
        "idle",
        "dnd",
        "offline"
      ],
      "default": "offline",
      "description": "Current online status"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last heartbeat"
    },
    "current_activity": {
      "type": "object",
      "properties": {
        "clanId": {
          "type": "string"
        },
        "gameId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "voiceRoomId": {
          "type": "string"
        },
        "partyId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        }
      },
      "description": "Context of what the user is currently doing"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "unlocked_achievements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": []
}