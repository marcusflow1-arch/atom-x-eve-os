{
  "name": "SocialRequest",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "friend",
        "party",
        "trade",
        "duel"
      ],
      "description": "Type of social request"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "receiver_id": {
      "type": "string",
      "description": "User ID of the receiver"
    },
    "receiver_name": {
      "type": "string",
      "description": "Display name of the receiver"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "cancelled"
      ],
      "default": "pending"
    },
    "party_id": {
      "type": "string"
    },
    "trade_id": {
      "type": "string"
    },
    "duel_id": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "sender_id",
    "sender_name",
    "receiver_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.receiver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}