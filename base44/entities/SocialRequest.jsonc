{
  "name": "SocialRequest",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "friend",
        "party",
        "trade",
        "duel"
      ],
      "description": "Type of social request"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "receiver_id": {
      "type": "string",
      "description": "User ID of the receiver"
    },
    "receiver_name": {
      "type": "string",
      "description": "Display name of the receiver"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "cancelled"
      ],
      "default": "pending"
    },
    "party_id": {
      "type": "string",
      "description": "If kind=party, the PartySession id involved"
    },
    "trade_id": {
      "type": "string",
      "description": "If kind=trade, a shared trade session id"
    },
    "duel_id": {
      "type": "string",
      "description": "If kind=duel, the DuelSession id created on accept"
    }
  },
  "required": [
    "kind",
    "sender_id",
    "sender_name",
    "receiver_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "sender_id": "{{user.id}}"
        },
        {
          "receiver_id": "{{user.id}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "sender_id": "{{user.id}}"
        },
        {
          "receiver_id": "{{user.id}}"
        }
      ]
    }
  }
}